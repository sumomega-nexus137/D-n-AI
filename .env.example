# Скопируйте этот файл в .env и заполните значения.
# НИКОГДА не коммитьте .env с реальным ключом — он в .gitignore.

# Google Gemini API key (Gemini Flash) — используется backend'ом и Telegram-ботом
# для голосовых сообщений (пересылка аудио напрямую в Gemini) и общения с пользователем.
# Получить ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# URL, на котором развёрнут backend (FastAPI), нужен веб-интерфейсу и боту
BACKEND_URL=http://localhost:8000

# Цена пшеницы для расчёта экономического эффекта, тенге за тонну (можно менять)
WHEAT_PRICE_KZT_PER_TON=90000
